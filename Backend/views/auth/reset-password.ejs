<% layout('layout') %>
<%- include('../partials/flash') %>

<main class="min-h-screen flex">
  <div class="hidden lg:flex lg:w-1/2 relative bg-surface-1 flex-col justify-between overflow-hidden">
    <div class="absolute inset-0 opacity-[0.06]" style="background-image: linear-gradient(rgba(240,165,0,0.3) 1px, transparent 1px), linear-gradient(90deg, rgba(240,165,0,0.3) 1px, transparent 1px); background-size: 60px 60px;"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-bg-base via-transparent to-transparent"></div>
    <div class="flex-1 flex items-center justify-center"><div class="w-20 h-20 border-2 border-accent-amber rounded-lg flex items-center justify-center"><svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#F0A500" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg></div></div>
    <div class="relative z-10 p-8">
      <h2 class="text-3xl font-semibold leading-tight mb-4">Credentials Updated</h2>
      <p class="font-mono text-sm text-text-secondary">Establish a new encryption key for your academic workspace.</p>
    </div>
  </div>

  <div class="w-full lg:w-1/2 flex flex-col justify-center items-center px-6 lg:px-16 py-12 bg-bg-base">
    <div class="w-full max-w-md page-enter">
      <h1 class="text-2xl font-semibold mb-2">Reset Password.</h1>
      <p class="text-text-secondary text-sm mb-8">Verify the OTP and provide a new password.</p>

      <form id="reset-password-form" class="space-y-6" novalidate>
        <input type="hidden" name="email" value="<%= typeof email !== 'undefined' ? email : '' %>">

        <div>
          <label class="mono-label block mb-2 text-center">VERIFICATION CODE (OTP)</label>
          <div class="flex justify-center gap-2 sm:gap-3" id="otp-container">
            <% for(let i=0; i<6; i++) { %>
            <input type="text" maxlength="1" class="otp-box w-10 h-12 sm:w-[52px] sm:h-[60px] text-lg sm:text-2xl" data-otp-index="<%= i %>" inputmode="numeric" pattern="[0-9]" autocomplete="one-time-code">
            <% } %>
          </div>
        </div>

        <div>
          <label class="mono-label block mb-2">NEW PASSWORD</label>
          <div class="relative">
            <input type="password" name="newPassword" placeholder="••••••••••" class="oxide-input pr-10" required autocomplete="new-password" id="password-input">
            <button type="button" class="absolute right-3 top-1/2 -translate-y-1/2 text-text-tertiary hover:text-text-primary transition-colors" onclick="togglePassword()">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" id="eye-icon">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            </button>
          </div>
          <div class="flex gap-1 mt-2">
            <div class="h-1 flex-1 rounded-full bg-border-default transition-colors duration-300" id="str-1"></div>
            <div class="h-1 flex-1 rounded-full bg-border-default transition-colors duration-300" id="str-2"></div>
            <div class="h-1 flex-1 rounded-full bg-border-default transition-colors duration-300" id="str-3"></div>
          </div>
        </div>

        <div>
          <label class="mono-label block mb-2">CONFIRM NEW PASSWORD</label>
          <div class="relative">
            <input type="password" name="confirmPassword" placeholder="••••••••••" class="oxide-input pr-10" required autocomplete="new-password" id="confirm-password-input">
            <button type="button" class="absolute right-3 top-1/2 -translate-y-1/2 text-text-tertiary hover:text-text-primary transition-colors" onclick="toggleConfirmPassword()">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" id="confirm-eye-icon">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            </button>
          </div>
          <div id="password-match-status" class="mt-1.5 font-mono text-[10px] hidden"></div>
        </div>

        <div id="form-error" class="hidden text-danger text-sm font-mono bg-danger-dim/20 border border-danger-dim rounded px-3 py-2"></div>

        <button type="submit" class="btn-primary w-full justify-center !py-3.5 !text-sm mt-4" id="submit-btn">
          <span class="dot"></span>
          <span id="btn-text">Reset Password</span>
        </button>

        <div class="text-center mt-6">
          <p class="text-xs text-text-secondary">
            Didn't receive the code? 
            <button type="button" onclick="resendResetOtp()" class="text-accent-amber hover:underline font-mono uppercase text-[10px] tracking-wider bg-transparent border-0 cursor-pointer p-0 ml-1" id="resend-otp-btn">
              Resend Code
            </button>
          </p>
        </div>
      </form>
    </div>
  </div>
</main>
<script src="/js/auth.js"></script>
<script>
  function togglePassword() {
    const input = document.getElementById('password-input');
    input.type = input.type === 'password' ? 'text' : 'password';
  }

  function toggleConfirmPassword() {
    const input = document.getElementById('confirm-password-input');
    input.type = input.type === 'password' ? 'text' : 'password';
  }

  const pwInput = document.getElementById('password-input');
  const confirmPwInput = document.getElementById('confirm-password-input');
  const matchStatus = document.getElementById('password-match-status');

  if (pwInput) {
    pwInput.addEventListener('input', function() {
      const val = this.value;
      let score = 0;
      if (val.length >= 8) score++;
      if (/[A-Z]/.test(val) && /[a-z]/.test(val)) score++;
      if (/[0-9]/.test(val) && /[^A-Za-z0-9]/.test(val)) score++;
      const colors = ['bg-danger', 'bg-accent-amber', 'bg-success'];
      for (let i = 1; i <= 3; i++) {
        document.getElementById('str-' + i).className = 'h-1 flex-1 rounded-full transition-colors duration-300 ' + (i <= score ? colors[score - 1] : 'bg-border-default');
      }
    });
  }

  function checkPasswordMatch() {
    if (!confirmPwInput || !pwInput || !matchStatus) return;
    const pw = pwInput.value;
    const cpw = confirmPwInput.value;

    if (!cpw) {
      matchStatus.classList.add('hidden');
      return;
    }

    matchStatus.classList.remove('hidden');
    if (pw === cpw) {
      matchStatus.textContent = '✓ PASSWORDS MATCH';
      matchStatus.className = 'mt-1.5 font-mono text-[10px] text-success';
    } else {
      matchStatus.textContent = '✗ PASSWORDS DO NOT MATCH';
      matchStatus.className = 'mt-1.5 font-mono text-[10px] text-danger';
    }
  }

  if (pwInput && confirmPwInput) {
    pwInput.addEventListener('input', checkPasswordMatch);
    confirmPwInput.addEventListener('input', checkPasswordMatch);
  }

  async function resendResetOtp() {
    let email = '';
    const emailInput = document.querySelector('input[name="email"]');
    if (emailInput) {
      email = emailInput.value;
    }
    if (!email) {
      const urlParams = new URLSearchParams(window.location.search);
      email = urlParams.get('email') || '';
    }
    
    const resendBtn = document.getElementById('resend-otp-btn');
    if (!email) {
      showFlash('Email address not found. Please re-initiate the process.', 'error');
      return;
    }

    const originalText = resendBtn.textContent;
    resendBtn.disabled = true;
    resendBtn.textContent = 'SENDING...';

    try {
      const res = await fetch('/api/students/resend-otp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, action: 'reset' })
      });
      const data = await res.json();
      if (res.ok) {
        showFlash('A fresh reset OTP has been sent to your email.', 'success');
        
        // Cooldown timer (60s)
        let cooldown = 60;
        resendBtn.textContent = `RESEND IN ${cooldown}S`;
        const interval = setInterval(() => {
          if (cooldown <= 1) {
            clearInterval(interval);
            resendBtn.disabled = false;
            resendBtn.textContent = 'RESEND CODE';
          } else {
            cooldown--;
            resendBtn.textContent = `RESEND IN ${cooldown}S`;
          }
        }, 1000);

      } else {
        throw new Error(data.message || 'Failed to resend OTP');
      }
    } catch (err) {
      showFlash(err.message, 'error');
      resendBtn.disabled = false;
      resendBtn.textContent = originalText;
    }
  }
</script>
