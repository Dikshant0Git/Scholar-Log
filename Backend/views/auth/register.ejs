<% layout('layout') %>
<%- include('../partials/flash') %>

<main class="min-h-screen flex">
  <!-- Left: Hero Panel -->
  <div class="hidden lg:flex lg:w-1/2 relative bg-surface-1 flex-col justify-between overflow-hidden">
    <!-- Grid Pattern -->
    <div class="absolute inset-0 opacity-[0.06]" style="background-image: linear-gradient(rgba(240,165,0,0.3) 1px, transparent 1px), linear-gradient(90deg, rgba(240,165,0,0.3) 1px, transparent 1px); background-size: 60px 60px;"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-bg-base via-transparent to-transparent"></div>

    <!-- Technical Overlay -->
    <div class="absolute top-1/3 left-8 right-8 font-mono text-xs text-text-tertiary/30 leading-loose">
      <p>SYSTEM DIAGNOSTIC</p>
      <p>// UNIT 045-A</p>
      <p>// VOLTAGE: 3.3V</p>
      <p>// TEMP: 45C</p>
      <p>STATUS: NOMINAL</p>
      <br>
      <p>OXIDE COMPUTER CO.</p>
      <p>DOCUMENT NO. OX-ENG-2845-D</p>
    </div>

    <!-- Bottom Brand -->
    <div class="relative z-10 p-8 mt-auto">
      <div class="flex items-center gap-2 mb-3">
        <div class="w-6 h-6 bg-accent-amber rounded flex items-center justify-center">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
        </div>
        <span class="font-mono text-xs font-medium tracking-wider text-accent-amber">SCHOLAR LOG</span>
      </div>
      <h2 class="text-3xl font-semibold leading-tight mb-4">Standardized Academic Logging</h2>
      <div class="border-l-2 border-border-emphasis pl-4">
        <p class="text-text-secondary text-sm leading-relaxed">Build a resilient knowledge base with terminal-adjacent precision. Secure, structured, and strictly formatted.</p>
      </div>
    </div>
  </div>

  <!-- Right: Register Form -->
  <div class="w-full lg:w-1/2 flex flex-col justify-center items-center px-6 lg:px-16 py-12 bg-bg-base">
    <div class="w-full max-w-md page-enter">
      <h1 class="text-2xl font-semibold mb-2">Create account.</h1>
      <p class="text-text-secondary text-sm mb-8">Initialize a new secure workspace instance.</p>

      <form id="register-form" class="space-y-5" novalidate>
        <!-- Name -->
        <div>
          <label class="mono-label block mb-2">FULL NAME</label>
          <input type="text" name="name" placeholder="Jane Doe" class="oxide-input" required autocomplete="name">
        </div>

        <!-- Email -->
        <div>
          <label class="mono-label block mb-2">EMAIL ADDRESS</label>
          <input type="email" name="email" placeholder="jane.doe@institution.edu" class="oxide-input" required autocomplete="email">
        </div>

        <!-- Mobile -->
        <div>
          <label class="mono-label block mb-2">MOBILE NUMBER</label>
          <input type="tel" name="mobile" placeholder="+1 (555) 000-0000" class="oxide-input" required autocomplete="tel">
        </div>

        <!-- Password -->
        <div>
          <label class="mono-label block mb-2">PASSWORD</label>
          <div class="relative">
            <input type="password" name="password" placeholder="••••••••••" class="oxide-input pr-10" required autocomplete="new-password" id="password-input">
            <button type="button" class="absolute right-3 top-1/2 -translate-y-1/2 text-text-tertiary hover:text-text-primary transition-colors" onclick="togglePassword()">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" id="eye-icon">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            </button>
          </div>
          <!-- Strength Bar -->
          <div class="flex gap-1 mt-2">
            <div class="h-1 flex-1 rounded-full bg-border-default transition-colors duration-300" id="str-1"></div>
            <div class="h-1 flex-1 rounded-full bg-border-default transition-colors duration-300" id="str-2"></div>
            <div class="h-1 flex-1 rounded-full bg-border-default transition-colors duration-300" id="str-3"></div>
          </div>
          <p class="font-mono text-xs mt-1.5 text-text-tertiary" id="strength-label">Encryption Key Strength: Waiting</p>
        </div>

        <!-- Error Message -->
        <div id="form-error" class="hidden text-danger text-sm font-mono bg-danger-dim/20 border border-danger-dim rounded px-3 py-2"></div>

        <!-- Submit -->
        <button type="submit" class="btn-primary w-full justify-center !py-3.5 !text-sm mt-2" id="submit-btn">
          <span class="dot"></span>
          <span id="btn-text">Initialize Account</span>
        </button>
      </form>

      <p class="text-center text-text-secondary text-sm mt-6">
        Already have an account? <a href="/login" class="text-text-primary underline underline-offset-4 hover:text-accent-amber transition-colors">Sign in</a>
      </p>

      <!-- Bottom Badge -->
      <div class="flex items-center justify-center gap-2 mt-12 text-text-tertiary">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        <span class="font-mono text-[10px] tracking-wider uppercase">END-TO-END ENCRYPTED SEGMENT</span>
      </div>
    </div>
  </div>
</main>

<script src="/js/auth.js"></script>
<script>
  function togglePassword() {
    const input = document.getElementById('password-input');
    input.type = input.type === 'password' ? 'text' : 'password';
  }

  // Password strength
  const pwInput = document.getElementById('password-input');
  if (pwInput) {
    pwInput.addEventListener('input', function() {
      const val = this.value;
      let score = 0;
      if (val.length >= 8) score++;
      if (/[A-Z]/.test(val) && /[a-z]/.test(val)) score++;
      if (/[0-9]/.test(val) && /[^A-Za-z0-9]/.test(val)) score++;

      const colors = ['bg-danger', 'bg-accent-amber', 'bg-success'];
      const labels = ['Weak', 'Nominal', 'Strong'];

      for (let i = 1; i <= 3; i++) {
        const el = document.getElementById('str-' + i);
        el.className = 'h-1 flex-1 rounded-full transition-colors duration-300 ' + (i <= score ? colors[score - 1] : 'bg-border-default');
      }
      document.getElementById('strength-label').textContent = 'Encryption Key Strength: ' + (score > 0 ? labels[score - 1] : 'Waiting');
    });
  }
</script>
