<% layout('layout') %>
<%- include('../partials/flash') %>

<main class="min-h-screen flex">
  <!-- Left: Hero -->
  <div class="hidden lg:flex lg:w-1/2 relative bg-surface-1 flex-col justify-between overflow-hidden">
    <div class="absolute inset-0 opacity-[0.06]" style="background-image: linear-gradient(rgba(240,165,0,0.3) 1px, transparent 1px), linear-gradient(90deg, rgba(240,165,0,0.3) 1px, transparent 1px); background-size: 60px 60px;"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-bg-base via-transparent to-transparent"></div>
    <div class="flex-1 flex items-center justify-center"><div class="w-20 h-20 border-2 border-accent-amber rounded-lg flex items-center justify-center"><svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#F0A500" stroke-width="1.5"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path></svg></div></div>
    <div class="relative z-10 p-8">
      <h2 class="text-3xl font-semibold leading-tight mb-4">Access Recovery</h2>
      <p class="font-mono text-sm text-text-secondary">Initiate a secure password reset sequence.</p>
    </div>
  </div>

  <!-- Right: Form -->
  <div class="w-full lg:w-1/2 flex flex-col justify-center items-center px-6 lg:px-16 py-12 bg-bg-base">
    <div class="w-full max-w-md page-enter">
      <h1 class="text-2xl font-semibold mb-2">Request reset.</h1>
      <p class="text-text-secondary text-sm mb-8">Enter your academic email address. If an account exists, we will send an OTP.</p>

      <form id="forgot-password-form" class="space-y-5" novalidate>
        <div>
          <label class="mono-label block mb-2">EMAIL ADDRESS</label>
          <input type="email" name="email" placeholder="user@example.com" class="oxide-input" required autocomplete="email">
        </div>

        <div id="form-error" class="hidden text-danger text-sm font-mono bg-danger-dim/20 border border-danger-dim rounded px-3 py-2"></div>

        <button type="submit" class="btn-primary w-full justify-center !py-3.5 !text-sm mt-4" id="submit-btn">
          <span class="dot"></span>
          <span id="btn-text">Send OTP</span>
        </button>
      </form>

      <p class="text-center text-text-secondary text-sm mt-8">
        <a href="/login" class="text-text-primary flex items-center justify-center gap-2 hover:text-accent-amber transition-colors">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          Return to login
        </a>
      </p>
    </div>
  </div>
</main>
<script src="/js/auth.js"></script>
