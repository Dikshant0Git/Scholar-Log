<% layout('layout') %>
<%- include('../partials/flash') %>
<main class="min-h-screen flex">
  <div class="hidden lg:flex lg:w-1/2 relative bg-surface-1 flex-col justify-between overflow-hidden">
    <div class="absolute inset-0 opacity-[0.06]" style="background-image: linear-gradient(rgba(240,165,0,0.3) 1px, transparent 1px), linear-gradient(90deg, rgba(240,165,0,0.3) 1px, transparent 1px); background-size: 60px 60px;"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-bg-base via-transparent to-transparent"></div>
    <div class="flex-1 flex items-center justify-center"><div class="w-20 h-20 border-2 border-accent-amber rounded-lg flex items-center justify-center"><svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#F0A500" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg></div></div>
    <div class="relative z-10 p-8">
      <h2 class="text-2xl font-semibold italic mb-2">Scholar Log</h2>
      <h3 class="text-xl font-medium mb-3">Secure Verification</h3>
      <p class="text-text-secondary text-sm leading-relaxed">Verifying your academic identity. This process ensures the integrity of the high-density academic network.</p>
    </div>
  </div>
  <div class="w-full lg:w-1/2 flex flex-col justify-center items-center px-6 lg:px-16 py-12 bg-bg-base">
    <div class="w-full max-w-md page-enter">
      <h1 class="text-2xl font-semibold mb-2">Check your inbox.</h1>
      <p class="text-text-secondary text-sm mb-10">Enter the 6-digit verification code sent to your academic email address to proceed.</p>
      <form id="verify-form" class="space-y-8" novalidate>
        <input type="hidden" name="email" value="<%= typeof email !== 'undefined' ? email : '' %>">
        <div class="flex justify-center gap-3" id="otp-container">
          <% for(let i=0; i<6; i++) { %>
          <input type="text" maxlength="1" class="otp-box" data-otp-index="<%= i %>" inputmode="numeric" pattern="[0-9]" autocomplete="one-time-code">
          <% } %>
        </div>
        <div id="form-error" class="hidden text-danger text-sm font-mono bg-danger-dim/20 border border-danger-dim rounded px-3 py-2"></div>
        <button type="submit" class="btn-primary w-full justify-center !py-3.5 !text-sm" id="submit-btn">
          <span class="dot"></span><span id="btn-text">Verify Code</span>
        </button>

        <div class="text-center mt-6">
          <p class="text-xs text-text-secondary">
            Didn't receive the code? 
            <button type="button" onclick="resendVerifyOtp()" class="text-accent-amber hover:underline font-mono uppercase text-[10px] tracking-wider bg-transparent border-0 cursor-pointer p-0 ml-1" id="resend-otp-btn">
              Resend Code
            </button>
          </p>
        </div>
      </form>
      <div class="flex items-center justify-center gap-2 mt-12 text-text-tertiary">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        <span class="font-mono text-[10px] tracking-wider uppercase">END-TO-END ENCRYPTED SEGMENT</span>
      </div>
    </div>
  </div>
</main>
<script src="/js/auth.js"></script>
<script>
  async function resendVerifyOtp() {
    let email = '';
    const emailInput = document.querySelector('input[name="email"]');
    if (emailInput) {
      email = emailInput.value;
    }
    if (!email) {
      const urlParams = new URLSearchParams(window.location.search);
      email = urlParams.get('email') || '';
    }
    
    const resendBtn = document.getElementById('resend-otp-btn');
    if (!email) {
      showFlash('Email address not found. Please re-initiate registration.', 'error');
      return;
    }

    const originalText = resendBtn.textContent;
    resendBtn.disabled = true;
    resendBtn.textContent = 'SENDING...';

    try {
      const res = await fetch('/api/students/resend-otp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, action: 'verify' })
      });
      const data = await res.json();
      if (res.ok) {
        showFlash('A fresh verification OTP has been sent to your email.', 'success');
        
        // Cooldown timer (60s)
        let cooldown = 60;
        resendBtn.textContent = `RESEND IN ${cooldown}S`;
        const interval = setInterval(() => {
          if (cooldown <= 1) {
            clearInterval(interval);
            resendBtn.disabled = false;
            resendBtn.textContent = 'RESEND CODE';
          } else {
            cooldown--;
            resendBtn.textContent = `RESEND IN ${cooldown}S`;
          }
        }, 1000);

      } else {
        throw new Error(data.message || 'Failed to resend OTP');
      }
    } catch (err) {
      showFlash(err.message, 'error');
      resendBtn.disabled = false;
      resendBtn.textContent = originalText;
    }
  }
</script>
