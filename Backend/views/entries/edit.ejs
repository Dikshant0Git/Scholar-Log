<% layout('layout') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/flash') %>

<main class="lg:pl-[220px] min-h-screen pt-14 lg:pt-0 flex flex-col">
  <!-- Topbar -->
  <header class="h-14 border-b border-border-default flex items-center justify-between px-6 bg-surface-1/80 backdrop-blur-sm sticky top-0 z-30">
    <div class="flex items-center gap-4">
      <a href="/entries/<%= entry._id %>" class="text-text-tertiary hover:text-text-primary transition-colors flex items-center justify-center w-6 h-6">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
      </a>
      <span class="font-mono text-xs text-text-primary">EDIT RECORD: <%= entry.title.toUpperCase() %></span>
    </div>
  </header>

  <div class="flex-1 p-4 sm:p-6 max-w-[1000px] w-full mx-auto">
    <form id="edit-entry-form" data-id="<%= entry._id %>" class="space-y-8 page-enter" novalidate>
      
      <!-- Top Row: Title, Duration -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="md:col-span-3">
          <label class="mono-label block mb-2">SUBJECT TITLE</label>
          <input type="text" id="entry-title" name="title" class="oxide-input text-lg font-medium" placeholder="E.g., Quantum Mechanics Lab 04" value="<%= entry.title %>" required>
        </div>
        <div>
          <label class="mono-label block mb-2">DURATION (MIN)</label>
          <input type="number" id="entry-duration" name="duration" class="oxide-input font-mono" placeholder="45" min="1" value="<%= entry.duration %>" required>
        </div>
      </div>

      <!-- Segment Controls: Difficulty, Status, Category -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div>
          <label class="mono-label block mb-2">COMPLEXITY LEVEL</label>
          <div class="segment-group" id="difficulty-group">
            <button type="button" class="segment-item <%= entry.difficulty === 'low' ? 'active' : '' %>" data-value="low">LOW</button>
            <button type="button" class="segment-item <%= entry.difficulty === 'medium' ? 'active' : '' %>" data-value="medium">NOMINAL</button>
            <button type="button" class="segment-item <%= entry.difficulty === 'high' ? 'active' : '' %>" data-value="high">HIGH</button>
          </div>
          <input type="hidden" id="entry-difficulty" name="difficulty" value="<%= entry.difficulty %>">
        </div>
        
        <div>
          <label class="mono-label block mb-2">STATUS</label>
          <div class="segment-group" id="status-group">
            <button type="button" class="segment-item <%= entry.status === 'pending' ? 'active' : '' %>" data-value="pending">PENDING</button>
            <button type="button" class="segment-item <%= entry.status === 'in-progress' ? 'active' : '' %>" data-value="in-progress">IN-PROGRESS</button>
            <button type="button" class="segment-item <%= entry.status === 'completed' ? 'active' : '' %>" data-value="completed">COMPLETED</button>
          </div>
          <input type="hidden" id="entry-status" name="status" value="<%= entry.status %>">
        </div>

        <div>
          <label class="mono-label block mb-2">CATEGORY</label>
          <div class="relative custom-select" id="custom-category-select">
            <button type="button" class="oxide-input !py-2.5 !px-3 font-mono text-xs flex items-center justify-between w-full cursor-pointer select-btn">
              <span class="selected-text flex items-center gap-2">
                <% 
                  let catVal = entry && entry.category ? entry.category : 'General';
                %>
                <span class="w-1.5 h-1.5 rounded-full bg-accent-amber animate-pulse"></span>
                <%= catVal.toUpperCase() %>
              </span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-text-tertiary transition-transform duration-200 chevron"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <input type="hidden" name="category" id="entry-category" value="<%= catVal %>">
            
            <div class="absolute left-0 right-0 mt-1.5 bg-surface-1 border border-border-emphasis shadow-2xl rounded-sm z-50 hidden dropdown-menu p-2 space-y-1 max-h-[300px] overflow-y-auto">
              <% 
                const categories = [
                  { val: 'General', desc: 'Miscellaneous academic logs, notes, and personal thoughts.' },
                  { val: 'Lecture', desc: 'Classroom notes, theoretical explanations, and highlights.' },
                  { val: 'Lab', desc: 'Practical implementations, setup logs, hardware/software debugging, and command outputs.' },
                  { val: 'Project', desc: 'Milestones, architecture design decisions, blockers, and progress updates.' },
                  { val: 'Research', desc: 'Literary reviews, whitepaper summaries, findings, and analytical studies.' },
                  { val: 'Exam Prep', desc: 'Practice questions, revisions, formula sheets, and study guide summaries.' }
                ];
              %>
              <% categories.forEach(cat => { %>
                <button type="button" class="w-full text-left p-2.5 hover:bg-surface-2 transition-colors rounded-sm flex flex-col gap-0.5 cursor-pointer option-item <%= catVal === cat.val ? 'active' : '' %>" data-value="<%= cat.val %>">
                  <span class="option-display-name font-mono text-xs text-text-primary flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-accent-amber"></span>
                    <%= cat.val.toUpperCase() %>
                  </span>
                  <span class="font-mono text-[9px] text-text-tertiary uppercase leading-normal"><%= cat.desc %></span>
                </button>
              <% }) %>
            </div>
          </div>
        </div>

        <div>
          <label class="mono-label block mb-2">COLLECTION / WORKSPACE</label>
          <div class="relative custom-select" id="custom-workspace-select">
            <button type="button" class="oxide-input !py-2.5 !px-3 font-mono text-xs flex items-center justify-between w-full cursor-pointer select-btn text-accent-amber border-accent-amber/30">
              <span class="selected-text flex items-center gap-2">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-accent-amber/70"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                <% 
                  let wsVal = '';
                  let wsName = 'NONE (UNCATEGORIZED)';
                  if (typeof workspaces !== 'undefined' && workspaces.length > 0) {
                    let matchingWs = workspaces.find(ws => entry.workspace && entry.workspace.toString() === ws._id.toString());
                    if (matchingWs) {
                      wsVal = matchingWs._id;
                      wsName = matchingWs.name.toUpperCase();
                    }
                  }
                %>
                <%= wsName %>
              </span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-text-tertiary transition-transform duration-200 chevron"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <input type="hidden" name="workspace" id="entry-workspace" value="<%= wsVal %>">
            
            <div class="absolute left-0 right-0 mt-1.5 bg-surface-1 border border-border-emphasis shadow-2xl rounded-sm z-50 hidden dropdown-menu p-2 space-y-1 max-h-[300px] overflow-y-auto">
              <button type="button" class="w-full text-left p-2.5 hover:bg-surface-2 transition-colors rounded-sm flex flex-col gap-0.5 cursor-pointer option-item <%= wsVal === '' ? 'active' : '' %>" data-value="">
                <span class="option-display-name font-mono text-xs text-text-primary flex items-center gap-2">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-text-tertiary"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                  NONE (UNCATEGORIZED)
                </span>
                <span class="font-mono text-[9px] text-text-tertiary uppercase leading-normal">Standalone log outside collections.</span>
              </button>
              <% if (typeof workspaces !== 'undefined' && workspaces.length > 0) { %>
                <% workspaces.forEach(ws => { %>
                  <button type="button" class="w-full text-left p-2.5 hover:bg-surface-2 transition-colors rounded-sm flex flex-col gap-0.5 cursor-pointer option-item <%= wsVal == ws._id ? 'active' : '' %>" data-value="<%= ws._id %>">
                    <span class="option-display-name font-mono text-xs text-accent-amber flex items-center gap-2">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-accent-amber/70"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                      <%= ws.name.toUpperCase() %>
                    </span>
                    <span class="font-mono text-[9px] text-text-tertiary uppercase leading-normal">Assigned to collection workspace.</span>
                  </button>
                <% }) %>
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <!-- Observation Log (Description) -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <label class="mono-label">OBSERVATION LOG</label>
          <div class="flex items-center gap-4 text-text-tertiary font-mono text-[9px] uppercase tracking-wider">
            <span id="log-counter" class="text-text-secondary">0/4000 Chars | 1/10000 Lines</span>
            <span class="opacity-30">|</span>
            <div class="flex items-center gap-1.5">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
              <span>Zero-knowledge encrypted</span>
            </div>
          </div>
        </div>
        <textarea id="entry-description" name="description" maxlength="4000" class="oxide-input !min-h-[240px] !py-4 font-sans leading-relaxed" placeholder="Record your technical observations here..."><%= entry.description %></textarea>
      </div>

      <!-- Attachments Dropzone -->
      <div>
        <label class="mono-label block mb-2">ATTACHMENTS</label>
        <div id="dropzone" class="dropzone">
          <div class="w-10 h-10 rounded-full border border-border-default mx-auto flex items-center justify-center mb-3 bg-surface-1">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path></svg>
          </div>
          <p class="text-sm text-text-secondary mb-1">Drag and drop files here or <span class="text-accent-amber underline cursor-pointer">browse</span></p>
          <p class="font-mono text-[10px] text-text-tertiary uppercase tracking-widest">JPG, PNG, PDF UP TO 10MB</p>
          <input type="file" id="file-input" class="hidden" multiple accept="image/*,.pdf">
        </div>
        
        <!-- Upload Previews -->
        <div id="upload-preview" class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-4 empty:hidden">
          <% if (entry.attachments && entry.attachments.length > 0) { %>
            <% entry.attachments.forEach((attachment, idx) => { 
                 let displayUrl = attachment.url;
                 if (!displayUrl && typeof attachment === 'string') displayUrl = attachment;
                 if (typeof displayUrl === 'object' && displayUrl.url) displayUrl = displayUrl.url;
                 
                 let publicId = attachment.public_id || '';
                 let isImage = displayUrl.match(/\.(jpeg|jpg|gif|png|webp)/i) != null || displayUrl.includes('res.cloudinary.com');
            %>
              <div class="relative aspect-square border border-border-default rounded bg-surface-2 overflow-hidden flex items-center justify-center existing-preview" data-url="<%= displayUrl %>" data-public-id="<%= publicId %>" data-resource-type="<%= attachment.resource_type || (isImage ? 'image' : 'raw') %>">
                <% if (isImage) { %>
                  <img src="<%= displayUrl %>" class="w-full h-full object-cover" loading="lazy">
                <% } else { %>
                  <div class="flex flex-col items-center justify-center h-full p-2">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-text-tertiary mb-2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                    <span class="font-mono text-[9px] text-text-secondary truncate w-full text-center">Attachment <%= idx+1 %></span>
                  </div>
                <% } %>
                <button type="button" onclick="removeExistingAttachment(this)" class="absolute top-1 right-1 w-6 h-6 bg-bg-base/80 rounded flex items-center justify-center text-text-tertiary hover:text-danger hover:bg-bg-base transition-colors cursor-pointer">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
              </div>
            <% }) %>
          <% } %>
        </div>
      </div>

      <!-- Footer Actions -->
      <div class="flex items-center justify-between pt-6 border-t border-border-default">
        <a href="/entries/<%= entry._id %>" class="font-mono text-xs text-text-tertiary hover:text-danger transition-colors flex items-center gap-2">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          CANCEL
        </a>
        
        <button type="submit" id="submit-btn" class="btn-primary !px-6">
          <span class="dot"></span>
          <span id="btn-text">Save Changes</span>
        </button>
      </div>

    </form>
  </div>
</main>

<script>
  // Global handler for existing EJS attachments
  function removeExistingAttachment(btn) {
    btn.parentElement.remove();
    // Dispatch custom event or call update function if populated
    if (window.syncUploadedFiles) {
      window.syncUploadedFiles();
    }
  }
</script>
<script src="/js/edit-entry.js?v=1.0.4"></script>
