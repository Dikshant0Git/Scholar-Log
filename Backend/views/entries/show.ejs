<% layout('layout') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/flash') %>

<main class="lg:pl-[220px] min-h-screen pt-14 lg:pt-0 flex flex-col">
  <!-- Topbar / Breadcrumb -->
  <%- include('../partials/topbar') %>

  <!-- Action Bar -->
  <div class="h-10 border-b border-border-default/50 flex items-center justify-between px-6 bg-surface-1 font-mono text-[9px] relative z-10">
    <div class="flex items-center gap-2 text-text-tertiary">
      <a href="/entries" class="hover:text-text-primary transition-colors uppercase">ENTRIES</a>
      <span class="opacity-30">/</span>
      <span class="text-text-primary truncate max-w-[200px] uppercase"><%= entry.title %></span>
    </div>
    <div class="flex items-center gap-4">
      <a href="/entries/<%= entry._id %>/edit" class="hover:text-accent-amber transition-colors uppercase flex items-center gap-1">
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
        EDIT RECORD
      </a>
      <span class="opacity-30">|</span>
      <button onclick="confirmTerminate(event, '<%= entry._id %>')" type="button" class="hover:text-red-500 transition-colors uppercase flex items-center gap-1 cursor-pointer bg-transparent border-none p-0 font-mono text-[9px]">
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
        TERMINATE RECORD
      </button>
    </div>
  </div>

  <div class="flex-1 p-4 sm:p-6 max-w-[1200px] w-full mx-auto flex flex-col lg:flex-row gap-6">
    
    <!-- Left Column: Content -->
    <div class="flex-1 space-y-6">
      
      <!-- Header -->
      <div class="scroll-reveal">
        <div class="flex flex-wrap items-center gap-2 mb-4">
          <span class="badge badge-<%= entry.status %>"><%= entry.status %></span>
          <span class="font-mono text-[10px] uppercase tracking-wider badge-<%= entry.difficulty %> border border-current px-2 py-0.5 rounded-sm"><%= entry.difficulty %></span>
        </div>
        <h1 class="text-3xl font-semibold tracking-tight mb-2"><%= entry.title %></h1>
        <div class="font-mono text-xs text-text-tertiary">ID: <%= entry._id %></div>
      </div>

      <!-- Description Content -->
       
      <div class="oxide-card scroll-reveal" style="transition-delay: 60ms;">
        <div class="flex items-center justify-between mb-4 pb-3 border-b border-border-default/50">
          <span class="mono-label-secondary">OBSERVATION_LOG</span>
          <div class="flex items-center gap-1.5 text-text-tertiary bg-surface-2 px-2 py-1 rounded-sm border border-border-default">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            <span class="font-mono text-[9px] uppercase tracking-wider">Zero-knowledge encrypted</span>
          </div>
        </div>
        
        <textarea readonly class="oxide-input !min-h-[240px] !h-[350px] !py-4 font-sans leading-relaxed resize-none cursor-default bg-surface-2 select-text scrollbar-thin focus:border-border-default" style="outline: none; border-color: var(--color-border-default);"><%= entry.description %></textarea>
      </div>

      <!-- Attachments -->
      <% if (entry.attachments && entry.attachments.length > 0) { %>
      <div class="oxide-card scroll-reveal" style="transition-delay: 120ms;">
        <span class="mono-label-secondary block mb-4 pb-3 border-b border-border-default/50">ATTACHED_MEDIA (<%= entry.attachments.length %>)</span>
        
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
          <% entry.attachments.forEach((attachment, idx) => { 
               let displayUrl = attachment.url;
               if (!displayUrl && typeof attachment === 'string') displayUrl = attachment;
               if (typeof displayUrl === 'object' && displayUrl.url) displayUrl = displayUrl.url;
               
               // Check if the attachment is an image
               const resourceType = attachment.resource_type || '';
               const isImage = resourceType === 'image' || 
                               (resourceType !== 'raw' && displayUrl && displayUrl.match(/\.(jpeg|jpg|gif|png|webp|svg)/i) !== null);
          %>
            <% if (isImage) { %>
              <a href="<%= displayUrl %>" target="_blank" class="block group relative aspect-square border border-border-default rounded-[var(--radius-oxide)] overflow-hidden bg-surface-2">
                <img src="<%= displayUrl %>" alt="Attachment <%= idx+1 %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy">
                <div class="absolute inset-0 bg-bg-base/60 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-text-primary"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"></path></svg>
                </div>
              </a>
            <% } else { %>
              <a href="<%= displayUrl %>" target="_blank" class="block group relative aspect-square border border-border-default rounded-[var(--radius-oxide)] overflow-hidden bg-surface-2 flex flex-col items-center justify-center p-4 text-center">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-accent-amber mb-2 transition-transform group-hover:scale-110 duration-200">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                </svg>
                <span class="font-mono text-[9px] text-text-secondary uppercase tracking-wider truncate w-full">
                  <%= displayUrl && displayUrl.toLowerCase().endsWith('.pdf') ? 'PDF_DOCUMENT' : 'ATTACHMENT' %>
                </span>
                <span class="font-mono text-[8px] text-text-tertiary mt-1">CLICK TO VIEW</span>
              </a>
            <% } %>
          <% }) %>
        </div>
      </div>
      <% } %>
    </div>

    <!-- Right Column: Metadata Sidebar -->
    <div class="w-full lg:w-[320px] shrink-0 space-y-6">
      
      <!-- Metadata Registry -->
      <div class="oxide-card scroll-reveal" style="transition-delay: 180ms;">
        <span class="mono-label-secondary block mb-4">METADATA_REGISTRY</span>
        
        <div class="space-y-4">
          <div class="flex justify-between items-end border-b border-border-default/50 pb-2">
            <span class="font-mono text-[10px] text-text-tertiary">DURATION</span>
            <span class="font-mono text-xs text-text-primary"><%= entry.duration %>m</span>
          </div>
          
          <div class="flex justify-between items-end border-b border-border-default/50 pb-2">
            <span class="font-mono text-[10px] text-text-tertiary">CREATED</span>
            <span class="font-mono text-xs text-text-primary text-right">
              <%= new Date(entry.createdAt).toLocaleDateString('en-US') %><br>
              <span class="text-[10px] text-text-secondary"><%= new Date(entry.createdAt).toLocaleTimeString('en-US') %></span>
            </span>
          </div>
          
          <div class="flex justify-between items-end border-b border-border-default/50 pb-2">
            <span class="font-mono text-[10px] text-text-tertiary">AUTHOR</span>
            <span class="font-mono text-xs text-text-primary"><%= user.name %></span>
          </div>

          <div class="flex justify-between items-end pb-1">
            <span class="font-mono text-[10px] text-text-tertiary">LAST MODIFIED</span>
            <span class="font-mono text-xs text-text-primary">
              <%= new Date(entry.updatedAt).toLocaleDateString('en-US') %>
            </span>
          </div>
        </div>
      </div>

      <!-- Controls -->
      <div class="oxide-card scroll-reveal" style="transition-delay: 240ms;">
        <span class="mono-label-secondary block mb-4">ENTRY_CONTROLS</span>
        
        <div class="space-y-4">
          <div>
            <label class="font-mono text-[10px] text-text-tertiary block mb-2">UPDATE STATUS</label>
            <div class="relative custom-select" id="custom-status-select">
              <button type="button" class="oxide-input !py-2 !px-3 font-mono text-xs flex items-center justify-between w-full cursor-pointer select-btn">
                <span class="selected-text flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-accent-amber animate-pulse"></span>
                  <%= entry.status.toUpperCase() %>
                </span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-text-tertiary transition-transform duration-200 chevron"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </button>
              <input type="hidden" name="status" value="<%= entry.status %>" onchange="updateEntryField('<%= entry._id %>', 'status', this.value)">
              
              <div class="absolute left-0 right-0 mt-1.5 bg-surface-1 border border-border-emphasis shadow-2xl rounded-sm z-50 hidden dropdown-menu p-2 space-y-1 max-h-[300px] overflow-y-auto">
                <% 
                  const statuses = [
                    { val: 'pending', label: 'PENDING', desc: 'Awaiting execution/review' },
                    { val: 'in-progress', label: 'IN-PROGRESS', desc: 'Currently active and ongoing' },
                    { val: 'completed', label: 'COMPLETED', desc: 'Successfully finalized' }
                  ];
                %>
                <% statuses.forEach(s => { %>
                  <button type="button" class="w-full text-left p-2.5 hover:bg-surface-2 transition-colors rounded-sm flex flex-col gap-0.5 cursor-pointer option-item <%= entry.status === s.val ? 'active' : '' %>" data-value="<%= s.val %>">
                    <span class="option-display-name font-mono text-xs text-text-primary flex items-center gap-2">
                      <span class="w-1.5 h-1.5 rounded-full bg-accent-amber"></span>
                      <%= s.label %>
                    </span>
                    <span class="font-mono text-[9px] text-text-tertiary uppercase leading-normal"><%= s.desc %></span>
                  </button>
                <% }) %>
              </div>
            </div>
          </div>
          
          <div>
            <label class="font-mono text-[10px] text-text-tertiary block mb-2">UPDATE COMPLEXITY</label>
            <div class="relative custom-select" id="custom-difficulty-select">
              <button type="button" class="oxide-input !py-2 !px-3 font-mono text-xs flex items-center justify-between w-full cursor-pointer select-btn">
                <span class="selected-text flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-accent-amber animate-pulse"></span>
                  <%= entry.difficulty === 'medium' ? 'NOMINAL' : entry.difficulty.toUpperCase() %>
                </span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-text-tertiary transition-transform duration-200 chevron"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </button>
              <input type="hidden" name="difficulty" value="<%= entry.difficulty %>" onchange="updateEntryField('<%= entry._id %>', 'difficulty', this.value)">
              
              <div class="absolute left-0 right-0 mt-1.5 bg-surface-1 border border-border-emphasis shadow-2xl rounded-sm z-50 hidden dropdown-menu p-2 space-y-1 max-h-[300px] overflow-y-auto">
                <% 
                  const difficulties = [
                    { val: 'low', label: 'LOW', desc: 'Straightforward execution' },
                    { val: 'medium', label: 'NOMINAL', desc: 'Standard complexity' },
                    { val: 'high', label: 'HIGH', desc: 'Complex, requires deep review' }
                  ];
                %>
                <% difficulties.forEach(d => { %>
                  <button type="button" class="w-full text-left p-2.5 hover:bg-surface-2 transition-colors rounded-sm flex flex-col gap-0.5 cursor-pointer option-item <%= entry.difficulty === d.val ? 'active' : '' %>" data-value="<%= d.val %>">
                    <span class="option-display-name font-mono text-xs text-text-primary flex items-center gap-2">
                      <span class="w-1.5 h-1.5 rounded-full bg-accent-amber"></span>
                      <%= d.label %>
                    </span>
                    <span class="font-mono text-[9px] text-text-tertiary uppercase leading-normal"><%= d.desc %></span>
                  </button>
                <% }) %>
              </div>
            </div>
          </div>
          
          <div>
            <label class="font-mono text-[10px] text-text-tertiary block mb-2">UPDATE CATEGORY</label>
            <div class="relative custom-select" id="custom-category-select">
              <button type="button" class="oxide-input !py-2 !px-3 font-mono text-xs flex items-center justify-between w-full cursor-pointer select-btn">
                <span class="selected-text flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-accent-amber animate-pulse"></span>
                  <%= entry.category.toUpperCase() %>
                </span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-text-tertiary transition-transform duration-200 chevron"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </button>
              <input type="hidden" name="category" value="<%= entry.category %>" onchange="updateEntryField('<%= entry._id %>', 'category', this.value)">
              
              <div class="absolute left-0 right-0 mt-1.5 bg-surface-1 border border-border-emphasis shadow-2xl rounded-sm z-50 hidden dropdown-menu p-2 space-y-1 max-h-[300px] overflow-y-auto">
                <% 
                  const categories = [
                    { val: 'General', label: 'GENERAL', desc: 'Miscellaneous academic logs, notes, and personal thoughts.' },
                    { val: 'Lecture', label: 'LECTURE', desc: 'Classroom notes, theoretical explanations, and highlights.' },
                    { val: 'Lab', label: 'LAB', desc: 'Practical implementations, setup logs, hardware/software debugging.' },
                    { val: 'Project', label: 'PROJECT', desc: 'Milestones, architecture design decisions, blockers, and progress.' },
                    { val: 'Research', label: 'RESEARCH', desc: 'Literary reviews, whitepaper summaries, findings, and analytical studies.' },
                    { val: 'Exam Prep', label: 'EXAM PREP', desc: 'Practice questions, revisions, formula sheets, and study guide summaries.' }
                  ];
                %>
                <% categories.forEach(cat => { %>
                  <button type="button" class="w-full text-left p-2.5 hover:bg-surface-2 transition-colors rounded-sm flex flex-col gap-0.5 cursor-pointer option-item <%= entry.category === cat.val ? 'active' : '' %>" data-value="<%= cat.val %>">
                    <span class="option-display-name font-mono text-xs text-text-primary flex items-center gap-2">
                      <span class="w-1.5 h-1.5 rounded-full bg-accent-amber"></span>
                      <%= cat.label %>
                    </span>
                    <span class="font-mono text-[9px] text-text-tertiary uppercase leading-normal"><%= cat.desc %></span>
                  </button>
                <% }) %>
              </div>
            </div>
          </div>

          

          <!-- <div class="border-t border-border-default/50 pt-4 flex flex-col gap-2">
            <a href="/entries/<%= entry._id %>/edit" class="btn-secondary !w-full !py-2 justify-center font-mono text-xs">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-1.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
              EDIT RECORD
            </a>
            <button onclick="confirmTerminate(event, '<%= entry._id %>')" type="button" class="btn-danger !w-full !py-2 justify-center font-mono text-xs cursor-pointer">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-1.5"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2 2v2"></path></svg>
              TERMINATE RECORD
            </button>
          </div> -->
        </div>
      </div>
      
    </div>
  </div>
</main>

<script>
  async function updateEntryField(id, field, value) {
    try {
      const res = await fetch(`/api/journal/${id}`, {
        method: 'PUT',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ [field]: value })
      });
      
      const data = await res.json();
      if (res.ok) {
        showFlash(`${field.toUpperCase()} UPDATED SUCCESSFULLY`, 'success');
        setTimeout(() => window.location.reload(), 1000);
      } else {
        throw new Error(data.message || 'Update failed');
      }
    } catch (err) {
      showFlash(err.message, 'error');
    }
  }

  async function confirmTerminate(e, id) {
    if (e) {
      e.preventDefault();
      e.stopPropagation();
    }
    
    window.showConfirmModal({
      title: 'TERMINATE JOURNAL RECORD',
      message: 'Are you absolutely sure you want to permanently terminate this academic log? This action is irreversible.',
      confirmText: 'CONFIRM TERMINATION',
      onConfirm: async () => {
        try {
          const res = await fetch(`/api/journal/${id}`, {
            method: 'DELETE',
            credentials: 'include'
          });
          
          const data = await res.json();
          if (res.ok) {
            showFlash('JOURNAL RECORD TERMINATED SUCCESSFULLY', 'success');
            setTimeout(() => window.location.href = '/entries', 1000);
          } else {
            throw new Error(data.message || 'Deletion failed');
          }
        } catch (err) {
          showFlash(err.message, 'error');
        }
      }
    });
  }
</script>
