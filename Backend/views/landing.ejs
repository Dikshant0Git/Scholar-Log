<% layout('layout') %>

<%- include('partials/navbar') %>
<%- include('partials/flash') %>

<!-- Hero Section — 50/50 Split -->
<main class="pt-14">
  <section class="min-h-[calc(100vh-56px)] flex flex-col lg:flex-row">
    <!-- Left: Hero Image -->
    <div class="relative w-full lg:w-1/2 min-h-[400px] lg:min-h-0 bg-surface-1 overflow-hidden">
      <!-- Technical Grid Pattern -->
      <div class="absolute inset-0 opacity-10" style="background-image: linear-gradient(rgba(240,165,0,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(240,165,0,0.1) 1px, transparent 1px); background-size: 40px 40px;"></div>

      <!-- Gradient Overlay -->
      <div class="absolute inset-0 bg-gradient-to-br from-bg-base/80 via-transparent to-bg-base/60"></div>

      <!-- Technical Overlay Text -->
      <div class="absolute top-8 left-8 font-mono text-xs text-text-tertiary/40 leading-relaxed hidden lg:block">
        <p>SYSTEM DIAGNOSTIC</p>
        <p>// UNIT 045-A</p>
        <p>// VOLTAGE: 3.3V</p>
        <p>// TEMP: 45C</p>
        <p>STATUS: NOMINAL</p>
        <br>
        <p>OXIDE COMPUTER CO.</p>
        <p>DOCUMENT NO. OX-ENG-2845-D</p>
      </div>

      <!-- Center Visual Element -->
      <div class="absolute inset-0 flex items-center justify-center">
        <div class="relative">
          <!-- Abstract Server Rack Graphic -->
          <div class="w-64 h-80 border border-border-default rounded-[var(--radius-oxide)] bg-surface-2/50 backdrop-blur-sm flex flex-col gap-2 p-4">
            <% for (let i = 0; i < 8; i++) { %>
              <div class="flex items-center gap-2">
                <div class="w-2 h-2 rounded-full <%= i === 0 ? 'bg-accent-amber pulse-amber' : i < 3 ? 'bg-success' : 'bg-border-emphasis' %>"></div>
                <div class="flex-1 h-3 bg-border-default rounded-sm"></div>
                <span class="font-mono text-[9px] text-text-tertiary"><%= String(i).padStart(2, '0') %></span>
              </div>
            <% } %>
            <div class="mt-auto border-t border-border-default pt-3">
              <div class="flex justify-between">
                <span class="font-mono text-[9px] text-text-tertiary">CPU</span>
                <span class="font-mono text-[9px] text-success">12%</span>
              </div>
              <div class="progress-track mt-1">
                <div class="progress-fill bg-success" style="width: 12%"></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- System Status -->
      <div class="absolute bottom-6 left-6 flex items-center gap-2 bg-bg-base/80 border border-border-default rounded px-3 py-1.5">
        <span class="w-2 h-2 rounded-full bg-accent-amber pulse-amber"></span>
        <span class="font-mono text-xs text-text-secondary">SYSTEM ACTIVE : NODE 01</span>
      </div>
    </div>

    <!-- Right: Content -->
    <div class="w-full lg:w-1/2 flex flex-col justify-center px-8 lg:px-16 py-16 bg-bg-base">
      <div class="max-w-lg">
        <!-- Version Label -->
        <div class="flex items-center gap-3 mb-8 scroll-reveal">
          <div class="w-8 h-[1px] bg-text-tertiary"></div>
          <span class="mono-label-secondary">SCHOLAR LOG V.2.4</span>
        </div>

        <!-- Headline -->
        <h1 class="text-4xl lg:text-5xl font-semibold leading-[1.1] tracking-tight mb-6 scroll-reveal" style="transition-delay: 60ms;">
          Academic Data<br>Precision.
        </h1>

        <!-- Description -->
        <p class="text-text-secondary text-base leading-relaxed mb-10 max-w-md scroll-reveal" style="transition-delay: 120ms;">
          A high-density, terminal-adjacent logging system engineered for academic rigor. Featuring zero-knowledge encryption and a keyboard-first interface for uncompromising data sovereignty.
        </p>

        <!-- CTAs -->
        <div class="flex gap-4 scroll-reveal" style="transition-delay: 180ms;">
          <a href="/register" class="btn-primary">
            Get Started
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
          <a href="#features" class="btn-secondary">
            Read Docs
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="border-t border-border-default"></div>

  <!-- Features Section -->
  <section id="features" class="max-w-[1200px] mx-auto px-6 py-24">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 stagger">
      <!-- Feature 1 -->
      <div class="oxide-card-hover scroll-reveal p-6">
        <div class="w-10 h-10 border border-border-default rounded flex items-center justify-center mb-5">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-text-secondary">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </div>
        <h3 class="text-lg font-medium mb-2">End-to-End Encryption</h3>
        <p class="text-text-secondary text-sm leading-relaxed">Zero-knowledge architecture ensures your data remains strictly confidential.</p>
      </div>

      <!-- Feature 2 -->
      <div class="oxide-card-hover scroll-reveal p-6">
        <div class="w-10 h-10 border border-border-default rounded flex items-center justify-center mb-5">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-text-secondary">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
          </svg>
        </div>
        <h3 class="text-lg font-medium mb-2">High-Density Metrics</h3>
        <p class="text-text-secondary text-sm leading-relaxed">Monospaced data views engineered to maximize information parsing speed.</p>
      </div>

      <!-- Feature 3 -->
      <div class="oxide-card-hover scroll-reveal p-6">
        <div class="w-10 h-10 border border-border-default rounded flex items-center justify-center mb-5">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-text-secondary">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
          </svg>
        </div>
        <h3 class="text-lg font-medium mb-2">Keyboard-First UX</h3>
        <p class="text-text-secondary text-sm leading-relaxed">Navigate, log, and analyze purely through command-line style shortcuts.</p>
      </div>
    </div>

    <!-- Version Footer -->
    <div class="mt-16 flex items-center justify-between border-t border-border-default pt-6">
      <span class="font-mono text-xs text-text-tertiary">v.2.4.1.stable</span>
      <div class="flex gap-1.5">
        <div class="w-6 h-1 rounded-full bg-text-tertiary"></div>
        <div class="w-1.5 h-1 rounded-full bg-border-emphasis"></div>
        <div class="w-1.5 h-1 rounded-full bg-border-emphasis"></div>
      </div>
    </div>
  </section>

  <!-- Architecture Section -->
  <section class="border-t border-border-default">
    <div class="max-w-[1200px] mx-auto px-6 py-24">
      <div class="flex items-center gap-3 mb-4 scroll-reveal">
        <div class="w-8 h-[1px] bg-text-tertiary"></div>
        <span class="mono-label">ARCHITECTURE</span>
      </div>
      <h2 class="text-3xl font-semibold mb-12 scroll-reveal" style="transition-delay: 60ms;">Engineered for Performance.</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 stagger">
        <div class="oxide-card scroll-reveal">
          <span class="mono-label text-accent-amber mb-3 block">01</span>
          <h3 class="text-sm font-medium mb-2">AES-256 Encryption</h3>
          <p class="text-text-tertiary text-xs leading-relaxed">Field-level encryption at rest. Your notes, your keys.</p>
        </div>
        <div class="oxide-card scroll-reveal">
          <span class="mono-label text-accent-amber mb-3 block">02</span>
          <h3 class="text-sm font-medium mb-2">Redis Caching</h3>
          <p class="text-text-tertiary text-xs leading-relaxed">Sub-millisecond analytics with distributed cache.</p>
        </div>
        <div class="oxide-card scroll-reveal">
          <span class="mono-label text-accent-amber mb-3 block">03</span>
          <h3 class="text-sm font-medium mb-2">Cloudinary CDN</h3>
          <p class="text-text-tertiary text-xs leading-relaxed">Images, videos, and files on a global edge network.</p>
        </div>
        <div class="oxide-card scroll-reveal">
          <span class="mono-label text-accent-amber mb-3 block">04</span>
          <h3 class="text-sm font-medium mb-2">Auto-Draft</h3>
          <p class="text-text-tertiary text-xs leading-relaxed">Never lose work. Automatic 5s saves to Redis.</p>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
