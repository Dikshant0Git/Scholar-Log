<%# Toast/flash notification container %>
<div id="flash-container" class="fixed top-20 right-4 z-[99999] flex flex-col gap-2 pointer-events-none">
  <%/* Flash messages are injected dynamically via JS */ %>
</div>

<template id="flash-template">
  <div class="flash-message pointer-events-auto flex items-center gap-3 px-4 py-3 rounded border bg-surface-1 min-w-[320px] max-w-[440px] shadow-lg opacity-0 translate-y-[-8px] transition-all duration-200"
       role="alert">
    <span class="flash-icon flex-shrink-0"></span>
    <span class="flash-text font-mono text-sm flex-1"></span>
    <button class="flash-close text-text-tertiary hover:text-text-primary transition-colors" onclick="this.closest('.flash-message').remove()">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>
</template>
