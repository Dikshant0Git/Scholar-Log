<!-- Theme Initialization (IIFE to prevent FOUC) -->
<script>
  (function() {
    const userTheme = '<%= (typeof user !== "undefined" && user && user.settings && user.settings.preferredTheme) ? user.settings.preferredTheme : "system" %>';
    let theme = 'dark';
    if (userTheme === 'light') {
      theme = 'light';
    } else if (userTheme === 'system') {
      theme = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
    }
    document.documentElement.setAttribute('data-theme', theme);
  })();
</script>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'A high-density, terminal-adjacent logging system engineered for academic rigor. Encrypted. Precise. Reliable.' %>">
