<%# Authenticated sidebar navigation %>
<aside id="sidebar" class="fixed top-0 left-0 h-screen w-[220px] bg-surface-1 border-r border-border-default flex flex-col z-50 transition-transform duration-200 max-lg:-translate-x-full max-lg:shadow-2xl" data-sidebar>
  <!-- Logo -->
  <div class="px-5 pt-5 pb-3">
    <a href="/dashboard" class="block">
      <span class="text-lg font-bold italic text-text-primary tracking-tight">SCHOLAR LOG</span>
      <p class="font-mono text-[10px] text-text-tertiary mt-0.5">Academic Data Log</p>
    </a>
  </div>

  <!-- Navigation -->
  <nav class="flex-1 px-3 mt-4 flex flex-col gap-1 overflow-y-auto custom-scrollbar">
    <a href="/dashboard"
       class="sidebar-link flex items-center gap-3 px-3 py-2.5 rounded text-sm transition-all duration-150 <%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'bg-surface-2 text-text-primary border-l-[3px] border-accent-amber -ml-px' : 'text-text-secondary hover:text-text-primary hover:bg-surface-2' %>">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="3" y="3" width="7" height="7" rx="1"></rect>
        <rect x="14" y="3" width="7" height="7" rx="1"></rect>
        <rect x="3" y="14" width="7" height="7" rx="1"></rect>
        <rect x="14" y="14" width="7" height="7" rx="1"></rect>
      </svg>
      Dashboard
    </a>

    <a href="/entries"
       class="sidebar-link flex items-center gap-3 px-3 py-2.5 rounded text-sm transition-all duration-150 <%= typeof activePage !== 'undefined' && activePage === 'entries' ? 'bg-surface-2 text-text-primary border-l-[3px] border-accent-amber -ml-px' : 'text-text-secondary hover:text-text-primary hover:bg-surface-2' %>">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="3" y="3" width="18" height="18" rx="2"></rect>
        <line x1="7" y1="8" x2="17" y2="8"></line>
        <line x1="7" y1="12" x2="17" y2="12"></line>
        <line x1="7" y1="16" x2="13" y2="16"></line>
      </svg>
      Entries
    </a>

    <a href="/entries/new"
       class="sidebar-link flex items-center gap-3 px-3 py-2.5 rounded text-sm transition-all duration-150 <%= typeof activePage !== 'undefined' && activePage === 'new-entry' ? 'bg-surface-2 text-text-primary border-l-[3px] border-accent-amber -ml-px' : 'text-text-secondary hover:text-text-primary hover:bg-surface-2' %>">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="3" y="3" width="18" height="18" rx="2"></rect>
        <line x1="12" y1="8" x2="12" y2="16"></line>
        <line x1="8" y1="12" x2="16" y2="12"></line>
      </svg>
      New Entry
    </a>

    <!-- Workspaces Section -->
    <div class="mt-6 mb-2 px-3 flex items-center justify-between">
      <span class="font-mono text-[10px] text-text-tertiary uppercase tracking-widest">WORKSPACES</span>
      <button onclick="showNewWorkspaceModal()" class="text-text-tertiary hover:text-accent-amber transition-colors">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
      </button>
    </div>
    
    <div id="sidebar-workspaces" class="flex flex-col gap-0.5">
      <% if (typeof workspaces !== 'undefined' && workspaces.length > 0) { %>
        <% workspaces.forEach(ws => { %>
          <a href="/workspaces/<%= ws._id %>" 
             class="sidebar-link flex items-center gap-3 px-3 py-2 rounded text-sm transition-all duration-150 <%= typeof activePage !== 'undefined' && activePage === 'workspace-' + ws._id.toString() ? 'bg-surface-2 text-text-primary border-l-[3px] border-accent-amber -ml-px' : 'text-text-secondary hover:text-text-primary hover:bg-surface-2' %>">
            <span class="w-2 h-2 rounded-full shrink-0" style="background-color: <%= ws.color || '#f59e0b' %>"></span>
            <span class="truncate"><%= ws.name %></span>
          </a>
        <% }) %>
      <% } else { %>
        <p class="px-3 py-2 font-mono text-[9px] text-text-tertiary uppercase">No collections yet</p>
      <% } %>
    </div>
  </nav>

  <!-- Bottom: Settings -->
  <div class="px-3 pb-5">
    <a href="/settings"
       class="sidebar-link flex items-center gap-3 px-3 py-2.5 rounded text-sm transition-all duration-150 <%= typeof activePage !== 'undefined' && activePage === 'settings' ? 'bg-surface-2 text-text-primary border-l-[3px] border-accent-amber -ml-px' : 'text-text-secondary hover:text-text-primary hover:bg-surface-2' %>">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="12" cy="12" r="3"></circle>
        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
      </svg>
      Settings
    </a>

    <button onclick="logout()"
            class="w-full mt-2 flex items-center gap-3 px-3 py-2.5 rounded text-sm text-danger hover:bg-danger/10 transition-all duration-150">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
        <polyline points="16 17 21 12 16 7"></polyline>
        <line x1="21" y1="12" x2="9" y2="12"></line>
      </svg>
      Log Out
    </button>
  </div>
</aside>

<!-- Mobile Sidebar Toggle -->
<button id="sidebar-toggle" class="lg:hidden fixed top-3 left-3 z-50 p-2 bg-surface-1 border border-border-default rounded" onclick="document.querySelector('[data-sidebar]').classList.toggle('max-lg:-translate-x-full')">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
    <line x1="3" y1="6" x2="21" y2="6"></line>
    <line x1="3" y1="12" x2="21" y2="12"></line>
    <line x1="3" y1="18" x2="21" y2="18"></line>
  </svg>
</button>

<!-- Sidebar Overlay for Mobile -->
<div class="lg:hidden fixed inset-0 bg-black/50 z-45 hidden" id="sidebar-overlay" onclick="document.querySelector('[data-sidebar]').classList.add('max-lg:-translate-x-full'); this.classList.add('hidden')"></div>
